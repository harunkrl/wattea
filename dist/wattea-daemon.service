[Unit]
Description=Wattea battery consumption collector
Documentation=https://github.com/harunkrl/wattea
# Run whether or not a battery is plugged in; however, starting once UPower is
# ready is preferred (so the first sample is consistent).
After=upower.service

[Service]
Type=simple
# Binary path: if installed via cargo install it lives in ~/.cargo/bin.
# You may change ExecStart to an absolute path (e.g. /usr/local/bin/wattea-daemon).
ExecStart=%h/.cargo/bin/wattea-daemon

# Sampling interval (seconds) — configurable via environment variable.
Environment=WATTEA_INTERVAL=60

# Restart: automatically recover from unexpected crashes.
Restart=on-failure
RestartSec=5

# Security hardening: reading the battery does NOT require root; it only reads
# sysfs and writes to the user's data directory. All within the user's privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=tmp

# Output goes to the journal: `journalctl --user -u wattea-daemon -f`
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wattea-daemon

[Install]
# Start in the user session; with enable-linger it also runs when the session is closed.
WantedBy=default.target
